# /etc/ceia-compute-observatory/agent.env  (chmod 640, dono root:ceia-agent)
# Comentários só em linhas próprias: o systemd (EnvironmentFile) não aceita comentário no fim da linha.

# IP/host da central (ou http://127.0.0.1 se for a mesma máquina)
CENTRAL_API_URL=http://203.0.113.10
AGENT_TOKEN=ceia_agt_COLE_AQUI_O_TOKEN_DESTA_MAQUINA
# Opcional; por padrão um UUID persistente é gerado
# MACHINE_ID=
COLLECTION_INTERVAL_SECONDS=15
BATCH_SIZE=40
HTTP_TIMEOUT_SECONDS=10
# ~34 dias a 15 s
BUFFER_MAX_SAMPLES=200000
# oldest | newest
BUFFER_DROP_POLICY=oldest
LOG_LEVEL=INFO
LOG_FILE=/var/log/ceia-compute-observatory/agent.log
HEALTH_BIND=127.0.0.1
HEALTH_PORT=9477
VERIFY_TLS=true
# Ranking de processos: top N por CPU e por GPU a cada amostra
COLLECT_PROCESSES=true
PROCESS_TOP_N=10
# false = não envia a linha de comando (só nome, usuário e PID)
PROCESS_CMDLINE=true
