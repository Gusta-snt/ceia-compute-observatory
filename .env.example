# ---- Plataforma central (deploy/docker-compose.yml) ----
POSTGRES_PASSWORD=troque-esta-senha
SECRET_KEY=gere-com-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-longa     # só usado para criar o 1º administrador
# Porta HTTP única (dashboard + API). 0.0.0.0 = acessível pela rede/internet; 127.0.0.1 = só local.
BIND_ADDR=0.0.0.0
HTTP_PORT=80
BACKEND_PORT=8000
FRONTEND_PORT=3000
COOKIE_SECURE=false                         # true só se servir o dashboard via HTTPS
CORS_ORIGINS=                               # vazio = mesma origem (recomendado)
RAW_RETENTION_DAYS=90                       # amostras brutas; depois viram rollups horários

# ---- Backend fora do Docker (desenvolvimento) ----
# DATABASE_URL=sqlite:///./observatory.db
# TIMEZONE=America/Sao_Paulo
